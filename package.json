{
  "name": "looptag",
  "version": "0.1.0",
  "private": true,
  "description": "Deposit-backed, transferable claims for reusable physical assets on Stellar",
  "license": "MIT",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "format:check": "pnpm -r format:check",
    "check:docs": "node scripts/check-docs.mjs",
    "check:deployments": "node scripts/check-deployments.mjs",
    "check:hygiene": "node scripts/check-repo-hygiene.mjs",
    "check:all": "pnpm check:docs && pnpm check:deployments && pnpm check:hygiene"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^3.2.4",
    "qrcode": "^1.5.4"
  }
}
