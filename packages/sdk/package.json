{
  "name": "@looptag/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the LOOPTAG deposit-claim protocol on Stellar",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^14.5.0",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
